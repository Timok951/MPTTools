# Пример для файла `.env` в корне репозитория (рядом с docker-compose.yml).
# Compose подставляет эти переменные в блок `environment:` до запуска контейнеров.
#
# Публичный URL Grafana для кнопки в меню Django (без завершающего слэша; путь /login добавляется в приложении).
GRAFANA_PUBLIC_URL=http://93.81.252.217:13816
#
# Редиректы и cookie Grafana (должен совпадать с тем, как пользователь открывает Grafana в браузере).
# GRAFANA_ROOT_URL=http://93.81.252.217:13816
