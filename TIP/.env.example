# Copy to .env and fill in locally. Do not commit .env.
# Django
# SECRET_KEY=
# DEBUG=true
# ALLOWED_HOSTS=your.domain,93.81.252.217
# Для Docker prometheus автоматически добавляются djangoapp, web (Host при скрейпе внутри сети).
# Отключить: INTERNAL_SCRAPE_HOSTS=
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Database (optional overrides)
# DATABASE_ENGINE=postgres
# DATABASE_NAME=mpt_tools
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Gmail SMTP (preferred when set)
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=

# Generic SMTP / Mailpit
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=noreply@example.com

# Anymail / Brevo (Sendinblue) — use only if not using Gmail SMTP above
# ANYMAIL_BREVO_API_KEY=

# Site URLs
# PUBLIC_SITE_URL=http://127.0.0.1:8000
# Grafana: при запуске через docker compose задайте GRAFANA_PUBLIC_URL в корневом .env (рядом с docker-compose.yml).
# Пункт меню по умолчанию ведёт на корень Grafana «/». Для /login: GRAFANA_MENU_PATH=/login
# GRAFANA_PUBLIC_URL=http://127.0.0.1:13816
# GRAFANA_MENU_PATH=/

# MESSAGE_EMAIL_ENABLED=true
